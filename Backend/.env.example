# Database connection URL (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pocketcircle

# Application Environment (development, staging, production)
ENVIRONMENT=development

# JWT Security (Must be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_characters_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Cookie Security (set to True in production with HTTPS)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CORS / Origin Security
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Service Configuration
# Choices: "auto", "resend", "smtp", "console"
# In local development, "console" prints OTPs directly to terminal.
# In production, "console" is rejected by validator; you must configure Resend or SMTP.
EMAIL_PROVIDER=auto

# Option A: Resend REST API (https://resend.com)
# IMPORTANT FOR PRODUCTION:
# Resend default sandbox ('onboarding@resend.dev') only delivers to your own account email.
# To send to ANY recipient in production:
# 1. Add and verify your custom domain at https://resend.com/domains
# 2. Set RESEND_FROM_EMAIL to a verified domain address (e.g. "PocketCircle <auth@yourdomain.com>")
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=PocketCircle <onboarding@resend.dev>

# Option B: SMTP Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_character_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_TLS=True

# OTP Security Settings
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
