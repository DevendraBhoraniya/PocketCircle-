# Database connection URL (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pocketcircle

# JWT Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_characters_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Cookie Security (set to False for local non-https development if needed)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CORS / Origin Security
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
