# PocketCircle Environment Configuration Template

# Database Configuration (Neon PostgreSQL in production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pocketcircle

# Security & Session Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_characters_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (Primary Public Authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Cookie Settings (Set COOKIE_SECURE=True in production HTTPS environments)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Email / Resend Testing Mode
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=PocketCircle <onboarding@resend.dev>
RESEND_TESTING_MODE=True
RESEND_PERMITTED_RECIPIENT=your_registered_resend_email@example.com

# Frontend Environment Variables (Vite)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_API_URL=http://localhost:8000
